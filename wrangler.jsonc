{

  "name": "trajectory",

  "compatibility_date": "2026-06-25",
  "routes": [
    { "pattern": "charliepolito.com/compass", "zone_name": "charliepolito.com" },
    { "pattern": "charliepolito.com/compass/*", "zone_name": "charliepolito.com" },
    { "pattern": "charliepolito.com/trajectory", "zone_name": "charliepolito.com" },
    { "pattern": "charliepolito.com/trajectory/*", "zone_name": "charliepolito.com" }
  ],
  "workers_dev": true,
  "preview_urls": false,

  "assets": {

    "directory": "./dist",

    // App has no client-side router, so unknown paths should 404 normally.

    "not_found_handling": "none"

  }

}

